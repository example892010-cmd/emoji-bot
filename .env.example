# Create a bot with @BotFather and paste its token here.
BOT_TOKEN=123456789:REPLACE_WITH_YOUR_BOT_TOKEN

# The public HTTPS origin assigned by Koyeb, without a trailing slash.
# Example: https://your-service-name.koyeb.app
WEBHOOK_URL=https://your-service-name.koyeb.app

# Set a random 32-64 character secret containing only A-Z, a-z, 0-9, _ or -.
WEBHOOK_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# SQLite database used only for webhook update deduplication.
DATABASE_PATH=data/bot.sqlite3

LOG_LEVEL=INFO
